<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="12dp"
        android:src="@drawable/ic_house_small"
        android:background="@drawable/bg_icon_soft"
        android:contentDescription="Household"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvHouseholdName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HH-0001 • Sharma Family"
            android:textColor="@color/navy"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHouseholdAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12 MG Road, Sector 5"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHouseholdStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submitted • 4 members"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_submitted"
            android:textColor="@color/green" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron"
        android:contentDescription="Open" />

</LinearLayout>