<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/navy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set new password"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a strong password for your account"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="28dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New password"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="At least 6 characters"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/navy"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnToggleNew"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_eye_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password"
                    app:tint="@color/muted" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm password"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Re-enter new password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/navy"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnToggleConfirm"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_eye_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password"
                    app:tint="@color/muted" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Update Password"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/blue"
                android:layout_marginTop="22dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>