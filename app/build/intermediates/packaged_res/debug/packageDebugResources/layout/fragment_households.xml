<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Households"
        android:textColor="@color/navy"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage households in your assigned area"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddHousehold"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="+  Add new household"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/blue"
        android:layout_marginTop="16dp"
        app:cornerRadius="14dp"
        app:elevation="0dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHouseholds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="14dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No households yet.\nTap Add new household to begin."
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone" />

</LinearLayout>