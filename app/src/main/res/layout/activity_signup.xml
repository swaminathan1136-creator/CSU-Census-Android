<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/navy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up your collector profile"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Your full name"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="6dp"
                android:inputType="textPersonName"
                android:textColor="@color/navy"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email address"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="6dp"
                android:textColor="@color/navy"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="At least 6 characters"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/navy"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_eye_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password"
                    app:tint="@color/muted" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm password"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="14dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Re-enter password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/bg_input"
                    android:textColor="@color/navy"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnToggleConfirm"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_eye_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password"
                    app:tint="@color/muted" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/blue"
                android:layout_marginTop="22dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvBackLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign in"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>