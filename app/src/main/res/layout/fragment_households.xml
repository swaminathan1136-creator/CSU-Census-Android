

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Households"
        android:textColor="@color/navy"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage the households in your assigned area"
        android:textColor="@color/muted"
        android:layout_marginTop="5dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddHousehold"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="＋  Add new household"
        android:textAllCaps="false"
        android:backgroundTint="@color/blue"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHouseholds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No households added yet. Tap Add new household to begin."
        android:textColor="@color/muted"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone" />

</LinearLayout>
